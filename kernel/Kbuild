ifdef KBUILD_EXTMOD
ifeq ($(CONFIG_KSU_DISABLE_MANAGER),y)
ccflags-y += -DCONFIG_KSU_DISABLE_MANAGER=1
endif
ifeq ($(CONFIG_KSU_DISABLE_POLICY),y)
ccflags-y += -DCONFIG_KSU_DISABLE_POLICY=1
endif
ifeq ($(CONFIG_KSU_DEBUG),y)
ccflags-y += -DCONFIG_KSU_DEBUG=1
endif
ifeq ($(CONFIG_KSU_X86_PATCH_SYSCALL_DISPATCHER),y)
ccflags-y += -DCONFIG_KSU_X86_PATCH_SYSCALL_DISPATCHER=1
endif
endif

ccflags-y += -I$(srctree)/security/selinux -I$(srctree)/security/selinux/include
ccflags-y += -I$(objtree)/security/selinux -include $(srctree)/include/uapi/asm-generic/errno.h

ifneq ($(KBUILD_EXTMOD),)
# 6.18 exports the external module source as srcroot when M/MO are used.
ifneq ($(srcroot),)
KSU_KERNEL_DIR := $(srcroot)
endif
endif
ifndef KSU_KERNEL_DIR
ifeq ($(filter /%,$(src)),)
KSU_KERNEL_DIR := $(srctree)/$(src)
else
KSU_KERNEL_DIR := $(src)
endif
endif

# Standalone DDK stages kernel/ and uapi/ as siblings; do not rely on the
# include/uapi symlink, which Windows checkouts can materialize as a text file.
ccflags-y += -I$(KSU_KERNEL_DIR) -I$(KSU_KERNEL_DIR)/include -I$(KSU_KERNEL_DIR)/..

# preinit runner: a static nolibc binary embedded into kernelsu, see preinit/.
# It is built against the installed UAPI headers of the target kernel
# (CONFIG_HEADERS_INSTALL, enabled by gki_defconfig).
KSU_UAPI_INC := $(objtree)/usr/include
ifneq ($(wildcard $(KSU_UAPI_INC)/linux/unistd.h),)
tomiesu-objs += preinit/preinit.o
tomiesu-objs += preinit/blob.o

KSU_RUNNER_CFLAGS := $(CLANG_FLAGS) -std=gnu11 -Os -Wall \
	-nostdinc -isystem $(shell $(CC) -print-file-name=include) \
	-I$(KSU_KERNEL_DIR)/preinit/runner/nolibc -I$(KSU_UAPI_INC) \
	-I$(KSU_KERNEL_DIR)/include -I$(KSU_KERNEL_DIR)/.. \
	-ffreestanding -fno-stack-protector -fno-pic -fno-pie \
	-fno-asynchronous-unwind-tables -fno-unwind-tables \
	-ffunction-sections -fdata-sections

quiet_cmd_ksu_runner = RUNNER  $@
      cmd_ksu_runner = $(CC) $(KSU_RUNNER_CFLAGS) -c -o $@.o $< && \
		$(LD) -static -nostdlib -e _start --gc-sections -s -o $@ $@.o && \
		rm -f $@.o

$(obj)/preinit/runner.elf: $(KSU_KERNEL_DIR)/preinit/runner/runner.c \
		$(wildcard $(KSU_KERNEL_DIR)/preinit/runner/nolibc/*.h \
			   $(KSU_KERNEL_DIR)/preinit/runner/nolibc/sys/*.h \
			   $(KSU_KERNEL_DIR)/../uapi/*.h) FORCE
	$(call if_changed,ksu_runner)

targets += preinit/runner.elf
$(obj)/preinit/blob.o: $(obj)/preinit/runner.elf
asflags-y += -DKSU_PREINIT_RUNNER_BIN=\"$(obj)/preinit/runner.elf\"
else
$(warning -- KernelSU: $(KSU_UAPI_INC) not found, preinit disabled)
ccflags-y += -DKSU_NO_PREINIT
endif


# 可选：把 Wind 驱动并入同一个 tomiesu.ko（CONFIG_WIND=y）
ifeq ($(CONFIG_WIND),y)
ccflags-y += -DCONFIG_WIND=1
# Wind 的跳板/影子页代码对 void* 定长缓冲做 memset，clang fortify 会误报
# __write_overflow_field；该告警类别在 wind 变体里整体关闭，不影响非 wind 变体。
ccflags-y += -Wno-attributes
tomiesu-objs += wind/sym.o
tomiesu-objs += wind/memory.o
tomiesu-objs += wind/process.o
tomiesu-objs += wind/entry.o
tomiesu-objs += wind/hide.o
tomiesu-objs += wind/breakpoint.o
# breakpoint.c 的跳板/影子页代码对 void* 缓冲区做定长 memset，
# clang 的 fortify 会把它误判成"越界写字段"（__write_overflow_field）。
# 这些缓冲由调用方保证 >= 32 字节，只关该文件的告警，不改语义。
CFLAGS_breakpoint.o += -Wno-attribute-warning
CFLAGS_wind/breakpoint.o += -Wno-attribute-warning
tomiesu-objs += wind/kgsl.o
tomiesu-objs += wind/gyro.o
tomiesu-objs += wind/nlcomm.o
endif

obj-$(CONFIG_KSU) += tomiesu.o

MDIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

# Use the same release identity as Manager and tsud, including source archives.
TOMIESU_VERSION_FILE := $(abspath $(MDIR)/../version.properties)
ifeq ($(wildcard $(TOMIESU_VERSION_FILE)),)
$(error TomieSU requires version.properties next to the kernel directory)
endif
include $(TOMIESU_VERSION_FILE)
TOMIESU_VERSION_VALID := $(shell printf '%s\n' '$(TOMIESU_VERSION_CODE)' | \
    awk '/^[0-9]+$$/ && $$0 >= 10000 && $$0 <= 2100000000 {print "yes"}')
ifneq ($(TOMIESU_VERSION_VALID),yes)
$(error Invalid TOMIESU_VERSION_CODE in version.properties)
endif
override KSU_VERSION := $(TOMIESU_VERSION_CODE)
$(info -- TomieSU version: $(TOMIESU_VERSION_NAME) ($(KSU_VERSION)))
ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
ccflags-y += -DKSU_VERSION_FULL=\"v$(TOMIESU_VERSION_NAME)-$(KSU_VERSION)\"

KSU_NEW_DCACHE_FLUSH := $(shell grep -q __flush_dcache_area $(srctree)/arch/arm64/include/asm/cacheflush.h ; echo $$?)
$(info -- KSU_NEW_DCACHE_FLUSH: $(KSU_NEW_DCACHE_FLUSH))

KSU_IS_PR_BUILD ?= 0
KSU_PACKAGE_NAME ?= io.tomiesu.manager

ifneq ($(CONFIG_KSU_DISABLE_MANAGER),y)
ifeq ($(strip $(KSU_EXPECTED_SIZE)),)
$(error TomieSU requires KSU_EXPECTED_SIZE from the Manager signing certificate)
endif
ifeq ($(strip $(KSU_EXPECTED_HASH)),)
$(error TomieSU requires KSU_EXPECTED_HASH from the Manager signing certificate)
endif
else
KSU_EXPECTED_SIZE ?= 0
KSU_EXPECTED_HASH ?= disabled
endif

$(info -- TomieSU Manager package name: $(KSU_PACKAGE_NAME))
$(info -- TomieSU Manager signature size: $(KSU_EXPECTED_SIZE))
$(info -- TomieSU Manager signature hash: $(KSU_EXPECTED_HASH))
$(info -- TomieSU is PR Build: $(KSU_IS_PR_BUILD))

ccflags-y += -DKSU_PACKAGE_NAME=\"$(KSU_PACKAGE_NAME)\"
ccflags-y += -DEXPECTED_SIZE=$(KSU_EXPECTED_SIZE)
ccflags-y += -DEXPECTED_HASH=\"$(KSU_EXPECTED_HASH)\"
ccflags-y += -DKSU_IS_PR_BUILD=$(KSU_IS_PR_BUILD)

ccflags-y += -DKSU_NEW_DCACHE_FLUSH=$(KSU_NEW_DCACHE_FLUSH)

ccflags-y += -Wno-strict-prototypes -Wno-int-conversion -Wno-gcc-compat -Wno-missing-prototypes
ccflags-y += -Wno-declaration-after-statement -Wno-unused-function

